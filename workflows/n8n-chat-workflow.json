{
  "name": "WP Chat Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wp-chat-assistant",
        "responseMode": "responseNode"
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{$json[\"site\"][\"url\"]}}/wp-json/n8n-chat/v1/qa",
        "options": {
          "headers": {
            "X-N8N-Token": "YOUR_QA_TOKEN"
          }
        }
      },
      "id": "Fetch QA",
      "name": "Fetch QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "systemPrompt",
              "value": "Eres un asistente para un sitio WordPress. Usa las preguntas y respuestas entregadas para responder. Si la pregunta está relacionada con agenda, propone horarios y pregunta por disponibilidad."
            }
          ]
        },
        "options": {}
      },
      "id": "Set Prompt",
      "name": "Set Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "model": "gpt-4.1",
        "messages": [
          {
            "role": "system",
            "content": "={{$json[\"systemPrompt\"]}}\n\nQ&A disponibles: {{$node[\"Fetch QA\"].json[\"items\"]}}"
          },
          {
            "role": "user",
            "content": "={{$node[\"Webhook\"].json[\"message\"]}}"
          }
        ],
        "options": {
          "temperature": 0.2
        }
      },
      "id": "OpenAI Chat",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 3,
      "position": [860, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "responseBody": "={{ { reply: $node[\"OpenAI Chat\"].json[\"choices\"][0][\"message\"][\"content\"] } }}",
        "responseCode": 200
      },
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1080, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fetch QA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch QA": {
      "main": [
        [
          {
            "node": "Set Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Prompt": {
      "main": [
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "America/Santiago"
  }
}
